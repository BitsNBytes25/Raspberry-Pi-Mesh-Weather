# Refer to https://github.com/BitsNBytes25/Raspberry-Pi-Mesh-Weather for full documentation.

# General Configuration
#
# Global settings that don't belong to any one service.
general:
  # Icon style used for forecast messages:
  #   "modern"     - colour emoji, best on modern clients
  #   "compatible" - U+2600-U+27BF block glyphs, safest on mesh devices
  #                  (default; avoids "*" glyphs on limited client fonts)
  icon_style: "compatible"
  # Name or organisation operating this service, displayed by the 'about' command.
  operated_by: ""

# Display Configuration
# Configuration to control the display on the raspberry pi, if one is present.
display:
  enabled: false


# Radio Configuration
radio:
  type: "meshcore"          # meshcore | meshtastic | cli
  interface: "serial"
  port: "/dev/ttyUSB0"
  # Only used when type: "cli" (the hardware-free development radio):
  # public-key prefix of the "sender" for un-targeted direct messages.  Leave
  # empty to fall back to the first auth_radios entry.  Use `@<pubkey>` at
  # the prompt to target a specific radio instead.
  target: ""


# List of hardware sensors attached to the Pi
sensors:
  - type: bme280
    port: 1
    address: 0x76


# Location Configuration
location:
  altitude: 250
  label: ""
  lat: ""
  lon: ""
  iata: XYZ


weather:
  # Set to your OpenWeatherMap API key for forecast projection support
  # Obtain this via https://home.openweathermap.org/api_keys
  openweather_api_key: ""


# Remote Integrations
home_assistant:
  url: ""
  token: ""


# Command Resolver (optional)
#
# Direct messages can be phrased in natural language (e.g. "what's the
# temperature?").  Each command function's docstring lines are its anchor
# phrasings; exact command/alias matches are always tried first and win, and
# the resolver only ever picks from the existing command catalog.  Replies are
# produced by the normal commands.  When the resolver is unavailable or no
# anchor matches closely enough (ai.threshold / ai.nltk_threshold), the usual
# "I don't understand that command" response is sent.
#
# Two backends are available, selected with ai.backend:
#   - "transformer" — a small in-process sentence transformer (no sidecar
#     process).  Best natural-language support, but heavy: the torch runtime
#     plus a ~39 MB model; a 2GB Raspberry Pi is the recommended minimum.
#     Replies typically take tens to low hundreds of milliseconds.
#   - "nltk" — a lightweight lexical resolver (stemmed TF-IDF bag-of-words
#     cosine similarity) with only a few hundred KB of nltk data and a few
#     MB of RAM.  The fallback for low-memory Pis.
# "auto" (default) uses the sentence-transformer resolver when it can load and
# falls back to nltk when it cannot (low-RAM Pis, or an offline Pi with no
# model cache).
resolver:
  enabled: false
  # "auto" | "ai" | "nltk" (see the section comment above)
  backend: auto
  # AI Transformer backend only:
  # Hugging Face model ID (auto-downloaded on first daemon load when online)
  # or an absolute path to a directory containing the model files for offline
  # Pis (e.g. produced with `huggingface-cli download ... --local-dir`).
  model_path: sentence-transformers/all-MiniLM-L6-v2
  # Minimum cosine similarity between a message and a command's anchors for it
  # to be considered a match (0.0-1.0; higher is stricter).  Transformer only.
  threshold: 0.55
  device: cpu
  # nltk backend only: minimum cosine similarity for a match.  Defaults to
  # ai.threshold when left unset.
  #nltk_threshold: 0.55


# Security
# List of radio IDs allowed for administrative tasks
auth_radios:
  - "123456789abc"
  - "cba987654321"


# MQTT Configuration
# This structure allows for multiple brokers as requested
mqtt:
  - host: "broker.example.com"
    port: 1883
    user: "username"
    password: "password"
    usage: packets
  - host: "backup.example.com"
    port: 1883
    usage: packets
